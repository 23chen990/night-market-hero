	elseif (params == 2) then
		value_scroll = 'gems'
	end

	msg.post(url_popup_iap, "popup", {
		owner_url = msg.url(),
		scroll_to = value_scroll
	})

	is_lock_input = true
	playSound("sfx_tap"..global.selected_sfx[10])

	global.isPopupOpened = true
	gameState:gameplayStop()

end

