local is_lock_input = false






local function on_btn_settings(self, params)
	msg.post(url_popup_settings, "popup", {
		owner_url = msg.url()
	})

	is_lock_input = true
	playSound("sfx_tap"..global.selected_sfx[10])

	global.isPopupOpened = true
	gameState:gameplayStop()

end

