local function change_mart(vValue)
	gameState:gameplayStop()
	
	msg.post(url_controller, "unload_background", {value = global.numMarket})

	global.numMarket = vValue
	datamanager.update_saves()

	msg.post(url_controller, "show_screen", {state="#proxy_game"})

	msg.post(url_controller, "show_background", {value = global.numMarket})

end

local function on_btn_marts(self, params)
	if (global.numMarket > 100)  then
		change_mart(1)
		return
	end
	msg.post(url_popup_markets, "popup", {
		owner_url = msg.url()
	})

	is_lock_input = true
	playSound("sfx_tap"..global.selected_sfx[10])

	global.isPopupOpened = true
	gameState:gameplayStop()

end

local function on_btn_event(self, params)
	if (global.numEvent == 1) and (global.numMarket ~= 101) then
		change_mart(101)
	end
	if (global.numEvent == 2) and (global.numMarket ~= 102) then
		change_mart(102)
	end

end

local function welcome_event(self)
	local eventType = ''

	if (global.numEvent == 1) then
		eventType = 'welcome_halloween'
	elseif (global.numEvent == 2) then
		eventType = 'welcome_christmas'
	end

	msg.post(url_popup_info, "popup", {
		owner_url = msg.url(),
		type = eventType
	})

	is_lock_input = true

	global.isPopupOpened = true
	gameState:gameplayStop()

end

local function event_completed(self, event_id)
	local numEvent = event_id
	local eventType = ''

	if (numEvent == 1) then
		eventType = 'completed_halloween'
	elseif (numEvent == 2) then
		eventType = 'completed_christmas'
	end

	msg.post(url_popup_info, "popup", {
		owner_url = msg.url(),
		type = eventType
	})

	is_lock_input = true

	global.isPopupOpened = true
	gameState:gameplayStop()

end

