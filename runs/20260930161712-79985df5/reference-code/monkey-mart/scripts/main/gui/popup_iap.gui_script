		description		= translate("REMOVE_ADS"),
		price_string	= "2,22 $",
		pos				= vmath.vector3(-100, -130, 0),
		icon			= "icon_offer_ads",
		frame_body		= "window_in_app4"
	})
	table.insert(list_iap, {
		num_set			= 4,
		type			= "item_special",
		value			= apimanager.NOADS_COINS_ID,
		description		= translate("IAP_NO_ADS_COINS"),
		price_string	= "2,22 $",
		pos				= vmath.vector3(100, -130, 0),
		icon			= "icon_noadscoins",
		additional		= global.amount2_iap,
		frame_body		= "window_in_app4"
	})

	
	table.insert(list_iap, {
		num_set			= 5,
		type			= "combo_offer",
		pos				= vmath.vector3(0, -140, 0),
	})

	local btn = nil

	for i=1,#list_iap do
		btn = create_element(self, list_iap[i])
		table.insert(self.list_btn, btn)
	end

	self.list_iap = list_iap

	self.button_gem1 = self.list_btn[3]
	self.button_gem2 = self.list_btn[4]
	self.button_gem3 = self.list_btn[5]

	self.button_special1 = self.list_btn[12]
	self.button_special2 = self.list_btn[13]

	self.button_combo = self.list_btn[14]

	self.button_combo:update_text_gems(global.gems_by_ads)

	update_scroll(self)

end

local function do_scroll(self, value_scroll)
	local scroll_cash = -770
	local scroll_gems = -1800

	if global.isMobileTrue then
		scroll_cash = -840
		scroll_gems = -1160

		local isHideManager = datamanager.isHaveManager()

		if (global.isBoughtManager or isHideManager) or (global.isBoughtFruit) then
			scroll_cash = -840 + 210
			scroll_gems = -1050 + 100
		end

		if (global.isBoughtManager or isHideManager) and global.isBoughtFruit then
			scroll_cash = 0
			scroll_gems = -1050 + 400
		end
	else
		scroll_cash = 0
		scroll_gems = -400
	end

	if value_scroll == 'cash' then
		self.scroll:scroll_to(vmath.vector3(0, scroll_cash, 0), true)
	elseif value_scroll == 'gems' then
		self.scroll:scroll_to(vmath.vector3(0, scroll_gems, 0), true)
	end

end

function init(self)
    msg.post(".", "acquire_input_focus")

    gui.set_render_order(4)

    node_popup_body = gui.get_node("body")
    node_popup_fade = gui.get_node("fade")

    gui.set_enabled(node_popup_body, false)
    gui.set_enabled(node_popup_fade, false)

    self.druid = druid.new(self)

    self.druid:new_button("btn_close", on_close_button)

	self.prefab = gui.get_node("button_component/root")
	gui.set_enabled(self.prefab, false)

	self.prefab2 = gui.get_node("button_component_pack/root")
	gui.set_enabled(self.prefab2, false)

	self.prefab3 = gui.get_node("button_component_combo_offer/root")
	gui.set_enabled(self.prefab3, false)

	initListButtons(self)
	updateListButtons(self)

	global.isIapGuiReady = true

end

function final(self)
	self.druid:final()

end

function update(self, dt)
	self.druid:update(dt)

end

function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)

    if (message_id == H_POPUP) then
		owner_url = message.owner_url

		if (config.isMobileTrue) and (not global.isDebug) then
			apimanager.check_network()
		end

		updateLanguage(self)
		show_popup()

		global.isPopupIapOpened = true

		if message.scroll_to then
			do_scroll(self, message.scroll_to)
		end

		if config.isEnableIAP then
			if iap then
				if iap_manager.iap_added then
					updateListButtons(self)
				else
					
					apimanager.sendAnalytics('ERROR:IAP_NOT_ADDED', 1)
					iap_manager.force_set_list()

				end
			else
				
				updateListButtons(self)
			end

		else
			updateListButtons(self)

		end

	elseif (message_id == H_INIT_LIST) then
		updateListButtons(self)

	elseif (message_id == H_UPDATE_GEMS) then
		updateButtonCombo(self)
		update_btns(self)

	elseif (message_id == H_DEACTIVATE) then
		gui.set_enabled(node_popup_body, false)
		gui.set_enabled(node_popup_fade, false)

    elseif (message_id == H_UNLOCK) then
		is_lock_input = false

	end

end

function on_input(self, action_id, action)
    if (not is_lock_input) then

		self.druid:on_input(action_id, action)

		if (action_id == hash("touch")) then
			if (action.pressed and (not gui.pick_node(node_popup_body, action.x, action.y))) then
				cancel_handler()
			end
		end

		return true

	end

end
