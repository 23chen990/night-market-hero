local H_POPUP = hash("popup")
local H_DEACTIVATE = hash("deactivate")
local H_BOUGHT_ITEM = hash("bought_item")
local H_UNLOCK = hash("unlock_input")
local H_INIT = hash("init_upgrades")

local ButtonComponent2 = require("main.gui.button_component2")

local node_popup_body = nil
local node_popup_fade = nil

local owner_url = nil
local is_lock_input = true

local function show_popup()
	is_lock_input = false
	gui.set_enabled(node_popup_fade, true)
	gui.set_enabled(node_popup_body, true)

	local window_width, window_height = camera.get_window_size()
	gui.set_size(node_popup_fade,vmath.vector3(window_width*2,window_height*2,0))

	gui.set_color(node_popup_fade, vmath.vector4(0, 0, 0, 0))
	gui.animate(
	node_popup_fade,
	gui.PROP_COLOR,
	vmath.vector4(0, 0, 0, 0.5),
	gui.EASING_OUTSINE,
	0.1)

	gui.set_position(node_popup_body, vmath.vector3(global.half_width,global.half_height,0))
	gui.set_color(node_popup_body, vmath.vector4(1, 1, 1, 0))
	gui.animate(
	node_popup_body,
	gui.PROP_COLOR,
	vmath.vector4(1, 1, 1, 1),
	gui.EASING_OUTSINE,
	0.1)

	gui.set_scale(node_popup_body, vmath.vector3(0.8, 0.8, 0.8))
	gui.animate(
	node_popup_body,
	gui.PROP_SCALE,
	vmath.vector3(1, 1, 1),
	gui.EASING_OUTBACK,
	0.25)

	if gameState.isTutorial then
		if (gameState.stepTutorial == 5) then
			local pos = gui.get_screen_position(gui.get_node("body"))
			gameState.stepTutorial = 6
			gameState:updateTutorial(pos)
		end
	end

end

local function hide_popup()
	is_lock_input = true

	gui.set_color(node_popup_fade, vmath.vector4(0, 0, 0, 0.5))
	gui.animate(
	node_popup_fade,
	gui.PROP_COLOR,
	vmath.vector4(0, 0, 0, 0),
	gui.EASING_INSINE,
	0.1)

	
	
	
	
	
	
	
	

	gui.set_scale(node_popup_body, vmath.vector3(1, 1, 1))
	gui.animate(
	node_popup_body,
	gui.PROP_SCALE,
	vmath.vector3(0.8, 0.8, 0.8),
	gui.EASING_INSINE,
	0.1,
	0,
	function()
		if (owner_url) then
			msg.post(owner_url, "unlock_input")
		end
	end)

end

local function cancel_handler()
	if gameState.isTutorial then
		if (gameState.stepTutorial < 7) then
			return
		elseif (gameState.stepTutorial == 7) then
			gameState.stepTutorial = 8
			gameState:updateTutorial()
		end
	end

	hide_popup()
	gameState:closePopup()
	global.isPopupOpened = false

	gameState:checkAvailableUpgrade()

end

local function on_close_button(self, params)
	cancel_handler()
	playSound("sfx_tap"..global.selected_sfx[10])

end

local function update_btns(self)
	local components = self.data_list:get_created_components()
	for _, component in pairs(components) do
		component:update_btn()
	end

end

local function update_from_ads(self, id, type)
	local upgrades_level = nil

	local upgrades_level = gameState.dataMart:getUpgradesData('upgrades_level')

	if (id == 1) then
		upgrades_level	= global.upgrades_level1
	end

	upgrades_level[id][type] = upgrades_level[id][type] + 1
	datamanager.update_saves()

	gameState:upgradeObject(id, type)

	update_btns(self)

end

local function check_upgrade(self, id, type)
	local upgrades_level = gameState.dataMart:getUpgradesData('upgrades_level')
	local upgrades_price = gameState.dataMart:getUpgradesData('upgrades_price')
	local upgrades_max = gameState.dataMart:getUpgradesData('upgrades_max')

	if (id == 1) then
		upgrades_level	= global.upgrades_level1
		upgrades_price	= global.upgrades_price1
		upgrades_max	= global.upgrades_max1
	end

	local get_lvl = upgrades_level[id][type]
	local price = 0
	local maxLevelUpgrade = upgrades_max[id][type]

	if get_lvl <= maxLevelUpgrade then
		price = upgrades_price[id][type][get_lvl]

		if price == 'ads' then
			is_lock_input = true

			msg.post(url_controller, "showAds", {
				type = 'upgrade',
				index = id,
				index2 = type
			})

			playSound("sfx_buy"..global.selected_sfx[1])
		elseif price == 'free' then
			upgrades_level[id][type] = upgrades_level[id][type] + 1
			datamanager.update_saves()
			gameState:upgradeObject(id, type)
			update_btns(self)
			playSound("sfx_buy"..global.selected_sfx[1])

			if gameState.isTutorial then
				if (gameState.stepTutorial == 6) then
					local pos = gui.get_screen_position(gui.get_node("btn_close"))
					gameState.stepTutorial = 7
					gameState:updateTutorial(pos)
				end
			end
		else
			local coins_value = coinmanager.get_balance()

			if (coins_value >= price) then
				coinmanager.minus_balance(price)
				upgrades_level[id][type] = upgrades_level[id][type] + 1

				datamanager.update_saves()

				gameState:upgradeObject(id, type)

				gameState:upgradeFromPopup()

				msg.post(url_screen_gui_game, "update_money")
				msg.post(url_screen_gui_game, "updateAttention", {type = "upgrade", bool = false})

				update_btns(self)

				playSound("sfx_buy"..global.selected_sfx[1])
			else
				msg.post(url_popup_message, "show_message", {text_id = "NO_MONEY"})
			end
		end

	end
end

local function on_button_click1(self, button, button_data)
	check_upgrade(self, button_data.value, 1)

end

local function on_button_click2(self, button, button_data)
	check_upgrade(self, button_data.value, 2)

end

local function on_button_click3(self, button, button_data)
	check_upgrade(self, button_data.value, 3)

end

local function create_element(self, data, index, data_list)
	local nodes = gui.clone_tree(self.prefab)
	local button = self.druid:new(ButtonComponent2, "button_component", nodes)
	gui.set_enabled(button.root, true)
	button:set_data(data)
	button:set_click_zone(data_list.scroll.view_node)

	button.on_click1:subscribe(function()
		on_button_click1(self, button, data)
	end, self)

	button.on_click2:subscribe(function()
		on_button_click2(self, button, data)
	end, self)

	button.on_click3:subscribe(function()
		on_button_click3(self, button, data)
	end, self)

	return button.root, button
end

local function updateLanguage(self)
	gui.set_text(gui.get_node("text_title"), utf8.upper(translate("UPGRADES")))

	utils.updateTextWidth(gui.get_node("text_title"), 140, 1.4)

end

