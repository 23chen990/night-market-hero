local function on_scroll(self)
	local scroll_percent = self.scroll:get_percent()
	self.slider:set(1 - scroll_percent.y, true)
	
end

local function on_slider(self, value)
	self.scroll:scroll_to_percent(vmath.vector3(0, 1 - value, 0), true)

	
	
end

local function update_scroll(self, value)
	self.scroll:scroll_to(vmath.vector3(0, value, 0), true)

end

local function initListUpgrades(self)
	if (global.numMarket == 1) then
		initUpgrades1(self)
	elseif (global.numMarket == 2) then
		initUpgrades2(self)
	elseif (global.numMarket == 3) then
		initUpgrades3(self)
	elseif (global.numMarket == 4) then
		initUpgrades4(self)
	elseif (global.numMarket == 5) then
		initUpgrades5(self)
	elseif (global.numMarket == 6) then
		initUpgrades6(self)
	elseif (global.numMarket == 101) then
		initUpgradesH(self)
	elseif (global.numMarket == 102) then
		initUpgradesC(self)
	end

    local scroll = self.druid:new_scroll("shop_mask", "shop_content")
    scroll:set_horizontal_scroll(false)

	scroll.on_scroll:subscribe(on_scroll)

	self.slider = self.druid:new_slider("slider_pin", vmath.vector3(-15, -484, 0), on_slider)
	self.slider:set_input_node("slider_back")

	self.scroll = scroll

	local grid = self.druid:new_grid("shop_content", self.prefab, 1)

    self.data_list = self.druid:new_data_list(scroll, grid, create_element)
    self.data_list:set_data(self.data_set)

	update_btns(self)

	if (global.numMarket == 101) then
		local sizeScroll = vmath.vector3(580, 520, 0)
		scroll:set_size(sizeScroll)

		gui.set_enabled(gui.get_node("slider_pin"), false)
		
	end

end

function init(self)
    msg.post(".", "acquire_input_focus")

    gui.set_render_order(4)

    node_popup_body = gui.get_node("body")
    node_popup_fade = gui.get_node("fade")

    gui.set_enabled(node_popup_body, false)
    gui.set_enabled(node_popup_fade, false)

    self.druid = druid.new(self)

    self.druid:new_button("btn_close", on_close_button)

    

	self.prefab = gui.get_node("button_component/root")
	gui.set_enabled(self.prefab, false)

    self.data_set = {}

	updateLanguage(self)

end

function final(self)
	self.druid:final()

end

function update(self, dt)
	self.druid:update(dt)

end

function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)

    if (message_id == H_POPUP) then
		owner_url = message.owner_url

		updateLanguage(self)
		update_btns(self)
		show_popup()

		if message.scrollValue then
			update_scroll(self, message.scrollValue)
		end

	elseif (message_id == H_DEACTIVATE) then
		gui.set_enabled(node_popup_body, false)
		gui.set_enabled(node_popup_fade, false)

    elseif (message_id == H_UNLOCK) then
		is_lock_input = false

    elseif (message_id == H_BOUGHT_ITEM) then
		is_lock_input = false

		update_from_ads(self, message.index, message.index2)

	elseif (message_id == H_INIT) then
		initListUpgrades(self)

	end

end

function on_input(self, action_id, action)
    if (not is_lock_input) then

		self.druid:on_input(action_id, action)

		if (action_id == hash("touch")) then
			if (action.pressed and (not gui.pick_node(node_popup_body, action.x, action.y))) then
				cancel_handler()
			end
		end

		return true

	end

end
