local H_POPUP = hash("popup")
local H_DEACTIVATE = hash("deactivate")
local H_UPDATE_TIME = hash("update_time")
local H_CLOSE = hash("close")

local node_popup_body = nil
local node_popup_fade = nil

local owner_url = nil
local is_lock_input = true

local function show_popup()
	is_lock_input = false
	gui.set_enabled(node_popup_fade, true)
	gui.set_enabled(node_popup_body, true)

	local window_width, window_height = camera.get_window_size()
	gui.set_size(node_popup_fade,vmath.vector3(window_width*2,window_height*2,0))

	gui.set_color(node_popup_fade, vmath.vector4(0, 0, 0, 0))
	gui.animate(
	node_popup_fade,
	gui.PROP_COLOR,
	vmath.vector4(0, 0, 0, 0.5),
	gui.EASING_OUTSINE,
	0.1)

	gui.set_position(node_popup_body, vmath.vector3(global.half_width,global.half_height,0))
	gui.set_color(node_popup_body, vmath.vector4(1, 1, 1, 0))
	gui.animate(
	node_popup_body,
	gui.PROP_COLOR,
	vmath.vector4(1, 1, 1, 1),
	gui.EASING_OUTSINE,
	0.1)

	gui.set_scale(node_popup_body, vmath.vector3(0.8, 0.8, 0.8))
	gui.animate(
	node_popup_body,
	gui.PROP_SCALE,
	vmath.vector3(1, 1, 1),
	gui.EASING_OUTBACK,
	0.25)

end

local function hide_popup()
	is_lock_input = true

	gui.set_color(node_popup_fade, vmath.vector4(0, 0, 0, 0.5))
	gui.animate(
	node_popup_fade,
	gui.PROP_COLOR,
	vmath.vector4(0, 0, 0, 0),
	gui.EASING_INSINE,
	0.1)

	gui.set_color(node_popup_body, vmath.vector4(1, 1, 1, 1))
	gui.animate(
	node_popup_body,
	gui.PROP_COLOR,
	vmath.vector4(1, 1, 1, 0),
	gui.EASING_INSINE,
	0.1)

	gui.set_scale(node_popup_body, vmath.vector3(1, 1, 1))
	gui.animate(
	node_popup_body,
	gui.PROP_SCALE,
	vmath.vector3(0.6, 0.6, 0.6),
	gui.EASING_INSINE,
	0.25,
	0,
	function()
		if (owner_url) then
			msg.post(owner_url, "unlock_input")
		end
	end)

end

local function cancel_handler()
	hide_popup()
	gameState:closePopup()
	global.isPopupOpened = false
	global.isPopupDeliveryOpened = false

end

local function on_close_button(self, params)
	cancel_handler(self)
	playSound("sfx_tap"..global.selected_sfx[10])

end

local function on_claim_button(self, params)
	cancel_handler(self)
	gameState:addRewardedCoins(gameState.dataDeliveryBoy.priceOrder)
	gameState:finishDeliveryBoy()

end

local function on_claim_x3_button(self, params)
	global.typeOffer = 'delivery_x3'

	if global.isMobileTrue then
		msg.post(url_popup_watch, "popup", {
			owner_url = msg.url()
		})
		gameState:stopMovement()

		global.isPopupOpened = true

	else
		gameState:showAdsForOffer()
	end

	hide_popup()
	global.isPopupOpened = false

end

local function update_time_order(self, timerOrder)
    local value_time = utils.secToHHMMSS(timerOrder)
	gui.set_text(self.text_info_time, value_time)

end

local function update_popup(self, vData)
    local typeFood1     = vData.typeFood
    local priceOrder	= vData.priceOrder
    local countFood1    = vData.countFood
    local needFood1     = vData.needFood
    local typeFood2     = vData.typeFood2
    local countFood2    = vData.countFood2
    local needFood2     = vData.needFood2
    local countWishrow  = vData.countWishrow
    local timerOrder	= vData.timerOrder
    local isCompleted   = vData.isCompleted
    local isReady       = vData.isReady

    if (not isReady) then
		lume.trace('[ WARNING ] missing Delivery Boy ready status')
        return
    end

    local value_food1 = countFood1 .. '/' .. needFood1
    local value_food2 = countFood2 .. '/' .. needFood2

    gui.set_text(self.count_food1, value_food1)
    
    gui.play_flipbook(self.icon_food1, "food"..typeFood1.."_icon")

    local ratio1 = utils.roundDecimal(countFood1/needFood1, 2)
    local sizeProgress1 = vmath.vector3(152 * ratio1, 38, 0)
    gui.set_size(self.progress_mask1, sizeProgress1)

	gui.set_position(self.plaha_food1, vmath.vector3(0,0,0))
	gui.set_position(self.plaha_food2, vmath.vector3(0,0,0))

    if (countWishrow == 2) then
        gui.set_text(self.count_food2, value_food2)

        gui.play_flipbook(self.icon_food2, "food"..typeFood2.."_icon")

        local ratio2 = utils.roundDecimal(countFood2/needFood2, 2)
        local sizeProgress2 = vmath.vector3(152 * ratio2, 38, 0)
        gui.set_size(self.progress_mask2, sizeProgress2)

        gui.set_enabled(self.icon_food2, true)
        gui.set_enabled(self.count_food2, true)
        gui.set_enabled(self.progress_mask2, true)
        gui.set_enabled(self.progress_back2, true)
    else
        gui.set_enabled(self.icon_food2, false)
        gui.set_enabled(self.count_food2, false)
        gui.set_enabled(self.progress_mask2, false)
        gui.set_enabled(self.progress_back2, false)

		gui.set_position(self.plaha_food1, vmath.vector3(0,35,0))
    end

    self.btn_claim:set_enabled(isCompleted)
    self.btn_claim_x3:set_enabled(isCompleted)

	local frameIcon = coinmanager.get_cashads_name()
	gui.play_flipbook(self.icon_cash, frameIcon)

	gui.set_text(self.text_cash, priceOrder)

	update_time_order(self, timerOrder)

end

local function updateLanguage(self)
    gui.set_text(gui.get_node("text_title"), utf8.upper(translate("DELIVERY_ORDER")))
    gui.set_text(gui.get_node("text_button"), utf8.upper(translate("CLAIM")))

    utils.updateTextWidth(gui.get_node("text_title"), 160, 1.4)
    utils.updateTextWidth(gui.get_node("text_button"), 200, 1)

end

function init(self)
	msg.post(".", "acquire_input_focus")

	gui.set_render_order(6)

	node_popup_body = gui.get_node("body")
	node_popup_fade = gui.get_node("fade")

	gui.set_enabled(node_popup_body, false)
	gui.set_enabled(node_popup_fade, false)

	self.druid = druid.new(self)

	self.druid:new_button("btn_close", on_close_button)
    self.btn_claim = self.druid:new_button("btn_claim", on_claim_button)
    self.btn_claim_x3 = self.druid:new_button("btn_claim_x3", on_claim_x3_button)
    
    self.icon_food1 = gui.get_node("icon_food1")
    self.icon_food2 = gui.get_node("icon_food2")
    self.count_food1 = gui.get_node("count_food1")
    self.count_food2 = gui.get_node("count_food2")
    self.progress_mask1 = gui.get_node("progress_mask1")
    self.progress_mask2 = gui.get_node("progress_mask2")
    self.progress_back1 = gui.get_node("progress_back1")
    self.progress_back2 = gui.get_node("progress_back2")
    self.icon_cash = gui.get_node("icon_cash")
    self.text_cash = gui.get_node("text_cash")
    self.text_info_time = gui.get_node("text_info_time")
    self.plaha_food1 = gui.get_node("plaha_food1")
    self.plaha_food2 = gui.get_node("plaha_food2")

	updateLanguage(self)

end

function final(self)
	self.druid:final()

end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)

	if (message_id == H_POPUP) then
		owner_url = message.owner_url

		updateLanguage(self)
		show_popup()
		update_popup(self, message.data)
		global.isPopupDeliveryOpened = true

	elseif (message_id == H_UPDATE_TIME) then
		update_time_order(self, message.value)

	elseif (message_id == H_CLOSE) then
		cancel_handler()

	elseif (message_id == H_DEACTIVATE) then
		gui.set_enabled(node_popup_body, false)
		gui.set_enabled(node_popup_fade, false)

	end
    
end

function on_input(self, action_id, action)
    if (not is_lock_input) then
		self.druid:on_input(action_id, action)

		if (action_id == hash("touch")) then
			if (action.pressed and (not gui.pick_node(node_popup_body, action.x, action.y))) then
				cancel_handler()
			end
		end

		return true

	end

end
