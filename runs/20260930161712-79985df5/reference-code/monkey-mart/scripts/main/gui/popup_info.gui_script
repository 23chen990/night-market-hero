local H_POPUP = hash("popup")
local H_DEACTIVATE = hash("deactivate")

local node_popup_body = nil
local node_popup_fade = nil

local owner_url = nil
local is_lock_input = true

local function show_popup()
	is_lock_input = false
	gui.set_enabled(node_popup_fade, true)
	gui.set_enabled(node_popup_body, true)

	local window_width, window_height = camera.get_window_size()
	gui.set_size(node_popup_fade,vmath.vector3(window_width*2,window_height*2,0))

	gui.set_color(node_popup_fade, vmath.vector4(0, 0, 0, 0))
	gui.animate(
	node_popup_fade,
	gui.PROP_COLOR,
	vmath.vector4(0, 0, 0, 0.5),
	gui.EASING_OUTSINE,
	0.1)

	gui.set_position(node_popup_body, vmath.vector3(global.half_width,global.half_height,0))
	gui.set_color(node_popup_body, vmath.vector4(1, 1, 1, 0))
	gui.animate(
	node_popup_body,
	gui.PROP_COLOR,
	vmath.vector4(1, 1, 1, 1),
	gui.EASING_OUTSINE,
	0.1)

	gui.set_scale(node_popup_body, vmath.vector3(0.8, 0.8, 0.8))
	gui.animate(
	node_popup_body,
	gui.PROP_SCALE,
	vmath.vector3(1, 1, 1),
	gui.EASING_OUTBACK,
	0.25)


end

local function hide_popup()
	is_lock_input = true

	gui.set_color(node_popup_fade, vmath.vector4(0, 0, 0, 0.5))
	gui.animate(
	node_popup_fade,
	gui.PROP_COLOR,
	vmath.vector4(0, 0, 0, 0),
	gui.EASING_INSINE,
	0.1)

	gui.set_color(node_popup_body, vmath.vector4(1, 1, 1, 1))
	gui.animate(
	node_popup_body,
	gui.PROP_COLOR,
	vmath.vector4(1, 1, 1, 0),
	gui.EASING_INSINE,
	0.1)

	gui.set_scale(node_popup_body, vmath.vector3(1, 1, 1))
	gui.animate(
	node_popup_body,
	gui.PROP_SCALE,
	vmath.vector3(0.6, 0.6, 0.6),
	gui.EASING_INSINE,
	0.25,
	0,
	function()
		if (owner_url) then
			msg.post(owner_url, "unlock_input")
		end
	end)

end

local function cancel_handler(self)
	hide_popup()

	if self.isFirstPopup then
		gameState:closePopup()
		global.isPopupOpened = false
	end

end

local function on_close_button(self, params)
	cancel_handler(self)
	playSound("sfx_tap"..global.selected_sfx[10])

end

local function on_select_button(self, params)
	
	
	

end

local function update_popup(self, typeInfo)
	gui.set_enabled(gui.get_node("title_event"), false)
	gui.set_enabled(gui.get_node("reward1"), false)
	gui.set_enabled(gui.get_node("reward2"), false)
	gui.set_enabled(gui.get_node("button"), false)
	gui.set_enabled(gui.get_node("btn_close"), false)
	gui.set_position(gui.get_node("text_title"), vmath.vector3(0,0,0))

	if typeInfo == "mart_completion" then
		gui.set_enabled(gui.get_node("btn_close"), true)

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_INFO_MART")))
		utils.updateTextWidth(gui.get_node("text_title"), 400, 1)

	elseif typeInfo == "welcome_halloween" then
		self.isFirstPopup = true

		gui.set_enabled(gui.get_node("title_event"), true)
		gui.set_enabled(gui.get_node("reward1"), true)
		gui.set_enabled(gui.get_node("reward2"), true)
		gui.set_enabled(gui.get_node("button"), true)

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_HALLOWEEN")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

		gui.set_position(gui.get_node("text_title"), vmath.vector3(0,-24,0))
		gui.set_position(gui.get_node("reward1"), vmath.vector3(-48,69,0))
		gui.set_position(gui.get_node("title_event"), vmath.vector3(0,161,0))

		gui.play_flipbook(gui.get_node("title_event"), "title_event_h")

	elseif typeInfo == "bonus_hat" then
		self.isFirstPopup = false

		gui.set_enabled(gui.get_node("btn_close"), true)

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_BONUS_HAT")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

	elseif typeInfo == "fruit_pack" then
		self.isFirstPopup = false

		gui.set_enabled(gui.get_node("reward1"), true)
		gui.set_enabled(gui.get_node("btn_close"), true)

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_FRUIT_DETAILS")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

		gui.play_flipbook(gui.get_node("reward1"), 'icon_fruit_pack1')
		gui.set_position(gui.get_node("reward1"), vmath.vector3(0,50,0))

		gui.set_position(gui.get_node("text_title"), vmath.vector3(0,-44,0))

	elseif typeInfo == "hat_join_event" then
		self.isFirstPopup = false

		gui.set_enabled(gui.get_node("btn_close"), true)

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_EVENT_HAT")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

	elseif typeInfo == "completed_halloween" then
		self.isFirstPopup = true
		gui.set_enabled(gui.get_node("title_event"), true)
		gui.set_enabled(gui.get_node("reward1"), true)
		gui.set_enabled(gui.get_node("btn_close"), true)

		gui.set_position(gui.get_node("reward1"), vmath.vector3(0,69,0))

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_HALLOWEEN_WIN")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

		gui.play_flipbook(gui.get_node("title_event"), "title_event_h")

	elseif typeInfo == "welcome_christmas" then
		self.isFirstPopup = true

		gui.set_enabled(gui.get_node("title_event"), true)
		gui.set_enabled(gui.get_node("reward1"), true)
		gui.set_enabled(gui.get_node("reward2"), true)
		gui.set_enabled(gui.get_node("button"), true)

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_CHRISTMAS")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

		gui.set_position(gui.get_node("text_title"), vmath.vector3(0,-24,0))
		gui.set_position(gui.get_node("reward1"), vmath.vector3(-48,69,0))
		gui.set_position(gui.get_node("title_event"), vmath.vector3(0,170,0))

		gui.play_flipbook(gui.get_node("title_event"), "title_event_c")
		gui.play_flipbook(gui.get_node("reward1"), 'hat38')
		gui.play_flipbook(gui.get_node("reward2"), 'hat39')

	elseif typeInfo == "completed_christmas" then
		self.isFirstPopup = true
		gui.set_enabled(gui.get_node("title_event"), true)
		gui.set_enabled(gui.get_node("reward1"), true)
		gui.set_enabled(gui.get_node("btn_close"), true)

		gui.set_position(gui.get_node("reward1"), vmath.vector3(0,69,0))
		gui.set_position(gui.get_node("title_event"), vmath.vector3(0,170,0))

		gui.set_text(gui.get_node("text_title"), utf8.upper(translate("TEXT_CHRISTMAS_WIN")))
		utils.updateTextWidth(gui.get_node("text_title"), 390, 1)

		gui.play_flipbook(gui.get_node("title_event"), "title_event_c")
		gui.play_flipbook(gui.get_node("reward1"), 'hat38')

	end

	if (not typeInfo) then
		self.isFirstPopup = true
		gui.set_enabled(gui.get_node("btn_close"), true)
	end

end

local function updateLanguage(self)
	gui.set_text(gui.get_node("text_button"), utf8.upper(translate("PLAY")))
	utils.updateTextWidth(gui.get_node("text_button"), 200, 1)

end

function init(self)
	msg.post(".", "acquire_input_focus")

	gui.set_render_order(6)

	node_popup_body = gui.get_node("body")
	node_popup_fade = gui.get_node("fade")

	
	

	gui.set_enabled(node_popup_body, false)
	gui.set_enabled(node_popup_fade, false)

	self.druid = druid.new(self)

	self.druid:new_button("button", on_close_button)
	self.druid:new_button("btn_close", on_close_button)

	updateLanguage(self)

end

function final(self)
	self.druid:final()

end

function update(self, dt)
	self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)

	if (message_id == H_POPUP) then
		owner_url = message.owner_url

		updateLanguage(self)
		show_popup()
		update_popup(self, message.type)

	elseif (message_id == H_DEACTIVATE) then
		gui.set_enabled(node_popup_body, false)
		gui.set_enabled(node_popup_fade, false)

	end
end

function on_input(self, action_id, action)
    if (not is_lock_input) then
		self.druid:on_input(action_id, action)

		return true
	end

end
