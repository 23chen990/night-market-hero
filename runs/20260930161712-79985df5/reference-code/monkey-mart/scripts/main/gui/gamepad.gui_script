local H_FOCUS_LOST = hash("focus_lost")
local H_FOCUS_GAINED = hash("focus_gained")
local STICK_MAX_DISTANCE = 65

local limitXmax = 960
local limitYmax = 500
local limitXmin = 0
local limitYmin = 0
local is_limit_move = false

local value_alpha1 = 0.0
local value_alpha2 = 0.0

local function update_alpha(self)
	local color1 = gui.get_color(self.analog)
	local color2 = gui.get_color(self.analog)
	color1.w = value_alpha1
	color2.w = value_alpha2
	gui.set_color(self.analog, color1)
	gui.set_color(self.analog_bg, color2)
end

local function showAnalog(self, isShow, isForce)
	gui.cancel_animation(self.analog, gui.PROP_COLOR)
	gui.cancel_animation(self.analog_bg, gui.PROP_COLOR)

	local color1 = gui.get_color(self.analog)
	local color2 = gui.get_color(self.analog)
	local duration = 0.2

	if isShow then
		color1.w = 1.0
		color2.w = 0.7

	else
		color1.w = value_alpha1
		color2.w = value_alpha2
	end

	if isForce then
		gui.set_color(self.analog, color1)
		gui.set_color(self.analog_bg, color2)
	else
		gui.animate(self.analog, gui.PROP_COLOR, color1, gui.EASING_LINEAR, duration)
		gui.animate(self.analog_bg, gui.PROP_COLOR, color2, gui.EASING_LINEAR, duration)
	end

end

local function post_to_listener(self, message_id, message)
	if self.listener then
		gameState:analogInput(message)
		
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.analog = gui.get_node("analog")
	self.analog_bg = gui.get_node("analog_bg")
	self.button_a = gui.get_node("button_a")
	
	self.left_stick_pos = gui.get_position(self.analog)

	self.left_stick_value = vmath.vector3()

	local tapPosition = vmath.vector3(800, 150, 0)
	gui.set_position(self.analog, tapPosition)
	gui.set_position(self.analog_bg, tapPosition)

	showAnalog(self, false, true)

	global.isGamePadGuiReady = true

end

function final(self)
	msg.post(".", "release_input_focus")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("register") then
		self.listener = sender

	elseif message_id == hash("unregister") then
		self.listener = nil

	elseif message_id == H_FOCUS_LOST then
		msg.post(".", "release_input_focus")
		lume.trace('H_FOCUS_LOST')

	elseif message_id == H_FOCUS_GAINED then
		msg.post(".", "acquire_input_focus")
		lume.trace('H_FOCUS_GAINED')

	elseif message_id == hash("do_untouch") then
		if self.analog_pressed then
			gui.animate(self.analog, gui.PROP_POSITION, self.left_stick_pos, gui.EASING_OUTQUAD, 0.2)
			post_to_listener(self, "analog", { x = 0, y = 0 })
			self.analog_pressed = nil

			showAnalog(self, false)
		end

	elseif message_id == hash("hideActionButton") then
		gui.set_enabled(self.button_a, false)

	elseif message_id == hash("hideJoystick") then
		gui.set_enabled(self.analog, false)
		gui.set_enabled(self.analog_bg, false)

	elseif message_id == hash("disableTapLimit") then
		is_limit_move = false

	elseif message_id == hash("setAlphaJoystick") then
		value_alpha1 = message.alpha1
		value_alpha2 = message.alpha2

		update_alpha(self)

	elseif message_id == hash("updateTapLimit") then
		if message.x_max then
			limitXmax = message.x_max
		end
		if message.x_min then
			limitXmin = message.x_min
		end
		if message.y_max then
			limitYmax = message.y_max
		end
		if message.y_min then
			limitYmin = message.y_min
		end

	end
end

local function updatePosition(self, vX, vY)
	local position = vmath.vector3(vX, vY, 0)
	local dx = self.left_stick_pos.x - vX
	local dy = self.left_stick_pos.y - vY
	local radians = math.atan2(dy, dx)
	local cos = math.cos(radians)
	local sin = math.sin(radians)
	local distance = math.sqrt(dx * dx + dy * dy)
	local radius = STICK_MAX_DISTANCE

	if distance > radius then
		position.x = self.left_stick_pos.x - cos * radius
		position.y = self.left_stick_pos.y - sin * radius
		distance = radius
	end

	gui.set_position(self.analog, position)
	post_to_listener(self, "analog", { x = -(cos * distance / radius), y = -(sin * distance / radius) })
end

local function handle_touch(self, touch, touch_index)
	

	if touch.pressed then
		if gui.is_enabled(self.button_a) and gui.pick_node(self.button_a, touch.x, touch.y) then
			post_to_listener(self, "button_a", { pressed = true })

			gui.set_scale(self.button_a, vmath.vector3(0.9,0.9,0.9))

		elseif gui.pick_node(self.analog, touch.x, touch.y) then
			gui.cancel_animation(self.analog, gui.PROP_POSITION)
			self.analog_pressed = { pos = vmath.vector3(touch.x, touch.y, 0), index = touch_index }

			showAnalog(self, true)
		end

	elseif touch.released then
		if self.analog_pressed and self.analog_pressed.index == touch_index then
			gui.animate(self.analog, gui.PROP_POSITION, self.left_stick_pos, gui.EASING_OUTQUAD, 0.2)
			post_to_listener(self, "analog", { x = 0, y = 0 })
			self.analog_pressed = nil

			showAnalog(self, false)
		else
			if gui.pick_node(self.button_a, touch.x, touch.y) then
				post_to_listener(self, "button_a", { released = true })

				gui.set_scale(self.button_a, vmath.vector3(1.0,1.0,1.0))

			
				
			end

		end

	elseif self.analog_pressed and self.analog_pressed.index == touch_index then
		updatePosition(self, touch.x, touch.y)

	end
end

function on_input(self, action_id, action)
	if global.isPopupOpened or global.isGameGuiPressed then
		return
	end

	
	

	if action.pressed then
		if (not is_limit_move) or
		(
			(action.x < limitXmax) and
			(action.y < limitYmax) and
			(action.x > limitXmin) and
			(action.y > limitYmin)
		) then
			local tapPosition = vmath.vector3(action.x, action.y, 0)
			gui.set_position(self.analog, tapPosition)
			gui.set_position(self.analog_bg, tapPosition)
			self.left_stick_pos = tapPosition
		end
	end

	
	if action.touch then
		for i,tp in pairs(action.touch) do
			
			
			handle_touch(self, tp, i)
		end
		global.countTouch = #action.touch

		if (#action.touch > 1) then
			lume.trace('!!! --> DETECT 2 inputs <-- !!!')
		end
	else
		handle_touch(self, action, 0)
		global.countTouch = 1
	end
	

	if action_id then
		local analogDetect = false

		
		if action_id == hash("left_stick_left") then
			self.left_stick_value.x = -STICK_MAX_DISTANCE * action.value
			gui.set_position(self.analog, self.left_stick_pos + self.left_stick_value)
			analogDetect = true

		elseif action_id == hash("left_stick_right") then
			self.left_stick_value.x = STICK_MAX_DISTANCE * action.value
			gui.set_position(self.analog, self.left_stick_pos + self.left_stick_value)
			analogDetect = true

		elseif action_id == hash("left_stick_up") then
			self.left_stick_value.y = STICK_MAX_DISTANCE * action.value
			gui.set_position(self.analog, self.left_stick_pos + self.left_stick_value)
			analogDetect = true

		elseif action_id == hash("left_stick_down") then
			self.left_stick_value.y = -STICK_MAX_DISTANCE * action.value
			gui.set_position(self.analog, self.left_stick_pos + self.left_stick_value)
			analogDetect = true

		end

		if analogDetect then
			local touch = self.left_stick_pos + self.left_stick_value
			updatePosition(self, touch.x, touch.y)
		end
	end

end
