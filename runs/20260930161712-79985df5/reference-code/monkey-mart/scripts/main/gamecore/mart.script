
function init(self)
    

    local pos = nil

    for i, box in pairs(gameState.listPlaceBoxes) do
        pos = go.get_position(box.link)

        gameState.listPlaceBoxes[i].pos = pos

        gameState.listPlaceBoxes[i].hash_animation = go.get(box.link.."#sprite", "animation")

        if (box.isSprite2) then
            gameState.listPlaceBoxes[i].hash_animation2 = go.get(box.link.."#sprite2", "animation")
        end

        if box.isPhysics then
            box.listPoints = {}
            box.listPoints.x = pos.x
            box.listPoints.y = pos.y

            if not go.exists(box.link.."_pA") then
                lume.trace("[ WARNING ] check physics points A B C D")
                break
            end

            box.listPoints.a = pos + go.get_world_position(box.link.."_pA")
            box.listPoints.b = pos + go.get_world_position(box.link.."_pB")
            box.listPoints.c = pos + go.get_world_position(box.link.."_pC")
            box.listPoints.d = pos + go.get_world_position(box.link.."_pD")

            local center = vmath.vector3(0,0,0)
            center.x = utils.round((box.listPoints.a.x + box.listPoints.b.x + box.listPoints.c.x + box.listPoints.d.x)/4)
            center.y = utils.round((box.listPoints.a.y + box.listPoints.b.y + box.listPoints.c.y + box.listPoints.d.y)/4)

            box.listPoints.mid = center

            go.delete(box.link.."_pA")
            go.delete(box.link.."_pB")
            go.delete(box.link.."_pC")
            go.delete(box.link.."_pD")

            box.listPoints.lines = {}
            table.insert(box.listPoints.lines, {ax=box.listPoints.a.x, ay=box.listPoints.a.y, bx=box.listPoints.b.x, by=box.listPoints.b.y})
            table.insert(box.listPoints.lines, {ax=box.listPoints.b.x, ay=box.listPoints.b.y, bx=box.listPoints.c.x, by=box.listPoints.c.y})
            table.insert(box.listPoints.lines, {ax=box.listPoints.c.x, ay=box.listPoints.c.y, bx=box.listPoints.d.x, by=box.listPoints.d.y})
            table.insert(box.listPoints.lines, {ax=box.listPoints.d.x, ay=box.listPoints.d.y, bx=box.listPoints.a.x, by=box.listPoints.a.y})

        end

        go.delete(go.get_id(box.link))
    end

    if (global.numMarket >= 2) then
        global.decors = {}

        local countDecors = 1
        local countWater = 0
        local countBorders = nil

        if global.numMarket == 2 then
            countDecors = 54
        elseif global.numMarket == 3 then
            countDecors = 71
        elseif global.numMarket == 4 then
            countDecors = 54
            countBorders = {20,10}
            countWater = 2
        elseif global.numMarket == 5 then
            countDecors = 108
        elseif global.numMarket == 6 then
            countDecors = 56
            countBorders = {12,8,11,9}
        elseif global.numMarket == 101 then
            countDecors = 66
            countBorders = {6,9,5}
        elseif global.numMarket == 102 then
            countDecors = 87
            countWater = 2
        end

        
        if countBorders and (#countBorders > 0) then
            local obj_border = nil

            for i=1,#countBorders do
                obj_border = "border"..i
                pos = go.get_position(obj_border)

                local borderPoints = {}

                for j=1,countBorders[i] do
                    table.insert(borderPoints, pos + go.get_world_position(obj_border.."_p"..j))
                    go.delete(go.get_id(obj_border.."_p"..j))
                end

                table.insert(gameState.listBorders, borderPoints)

            end
        end

        
        if countWater > 0 then
            local waterPoints = nil
            local obj_water = nil

            for i=1,countWater do
                obj_water = "water"..i
                pos = go.get_position(obj_water)

                waterPoints = {}
                waterPoints.x = pos.x
                waterPoints.y = pos.y
                waterPoints.a = pos + go.get_world_position(obj_water.."_pA")
                waterPoints.b = pos + go.get_world_position(obj_water.."_pB")
                waterPoints.c = pos + go.get_world_position(obj_water.."_pC")
                waterPoints.d = pos + go.get_world_position(obj_water.."_pD")

                go.delete(obj_water.."_pA")
                go.delete(obj_water.."_pB")
                go.delete(obj_water.."_pC")
                go.delete(obj_water.."_pD")

                table.insert(gameState.listWater, waterPoints)
            end

        end

        
        local hash_animation = nil
        local obj = nil
        local isFlip = false
        local scale = 1
        local angle = 0

        for i=1,countDecors do
            obj = "dec"..i
            pos = go.get_position(obj)
            hash_animation = go.get(obj.."#sprite", "animation")
            isFlip = go.get(obj, "euler.y")
            angle = go.get(obj, "euler.z")
            scale = go.get(obj, "scale").x

            table.insert(global.decors, {
                pos = pos,
                hash_frame = hash_animation,
                isFlip = isFlip == 180,
                scale = scale,
                angle = angle
            })

            go.delete(go.get_id(obj))


        end
    end

end
