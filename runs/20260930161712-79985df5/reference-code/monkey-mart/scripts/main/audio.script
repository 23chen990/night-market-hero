local function initSfxVolume()
	msg.post("/audio#sfx_payment",		"set_gain", {gain = 1.5})
	msg.post("/audio#sfx_broom",		"set_gain", {gain = 3.0})
	msg.post("/audio#sfx_alarm",		"set_gain", {gain = 1.6})
	msg.post("/audio#sfx_repair",		"set_gain", {gain = 2.0})

	msg.post("/audio#sfx_buy2",			"set_gain", {gain = 6.0})
	msg.post("/audio#sfx_cash2",		"set_gain", {gain = 2.7})
	msg.post("/audio#sfx_chicken1",		"set_gain", {gain = 2.8})
	msg.post("/audio#sfx_chicken2",		"set_gain", {gain = 4.6})
	msg.post("/audio#sfx_collect4",		"set_gain", {gain = 5.2})
	msg.post("/audio#sfx_cow1",			"set_gain", {gain = 1.7})
	msg.post("/audio#sfx_cow2",			"set_gain", {gain = 2.2})
	msg.post("/audio#sfx_pig1",			"set_gain", {gain = 1.0})
	msg.post("/audio#sfx_delete3",		"set_gain", {gain = 2.8})

	msg.post("/audio#sfx_happy3",		"set_gain", {gain = 3.8})
	msg.post("/audio#sfx_happy4",		"set_gain", {gain = 5.3})
	msg.post("/audio#sfx_happy5",		"set_gain", {gain = 4.6})

	msg.post("/audio#sfx_newobject1",	"set_gain", {gain = 4.0})
	msg.post("/audio#sfx_stock1",		"set_gain", {gain = 2.3})
	msg.post("/audio#sfx_tap1",			"set_gain", {gain = 1.3})

	msg.post("/audio#sfx_applause",		"set_gain", {gain = 0.8})
	msg.post("/audio#sfx_pook",			"set_gain", {gain = 0.9})

end

local function sound_done(self, message_id, message, sender)
	if message_id == hash("sound_done") and message.play_id == self.countdown_id then

		if (config.platform == PLATFORM_WEB) and (global.playingMusic == "main_short") then
			if global.isMusicLongLoaded then
				msg.post(url_audio_add, "play_music", {sound="main_long"})

			else
				self.countdown_id = sound.play("/audio#"..global.playingMusic, nil, sound_done)

			end
		end

	end

end

function on_message(self, message_id, message, sender)
	if message_id == hash("play_music") then
		if message.sound == "main_short" then
			self.countdown_id = sound.play("/audio#".."main_short", nil, sound_done)

		elseif message.sound == "main_long" then
			
			sound.play("/audio#".."main_long")

		end

		global.playingMusic = message.sound
		

	elseif message_id == hash("stop_music") then
		msg.post("/audio#"..message.music, "stop_sound")

	elseif message_id == hash("play_sfx") then
		msg.post("/audio#"..message.sound, "play_sound")

	elseif message_id == hash("init_sfx_volume") then
		initSfxVolume()

	end

end

 
	

