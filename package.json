{
  "name": "night-market-hero-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts --config eslint.config.js",
    "build": "node --import tsx scripts/build.ts",
    "test:file": "node --import tsx tests/file-launch-smoke.ts",
    "pretest": "node --import tsx scripts/build.ts",
    "test:play": "node --import tsx tests/playable-browser-audit.ts",
    "test:pursuit": "node --import tsx tests/v2-pursuit-natural-browser.ts",
    "verify:chase-matrix": "node tests/v2-chase-matrix-gate.mjs",
    "test:safety": "node --import tsx tests/playable-safety-audit.ts",
    "preverify:release": "node --import tsx scripts/build.ts",
    "verify:release": "node validate-runtime-product-gates.mjs --strict",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.2.2"
  }
}
